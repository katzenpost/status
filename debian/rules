#!/usr/bin/make -f
export PYBUILD_NAME=katzenpost_status
export SOURCE_DATE_EPOCH ?= $(shell dpkg-parsechangelog -STimestamp)

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	PYTHONPATH=$(CURDIR)/src python3 -m pytest -o addopts= -o markers=asyncio -q

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_install:
	dh_install
	if [ -d src/katzenpost_status/assets ]; then \
		install -d debian/katzenpost-status/usr/lib/python3/dist-packages/katzenpost_status/assets; \
		cp -a src/katzenpost_status/assets/. debian/katzenpost-status/usr/lib/python3/dist-packages/katzenpost_status/assets/; \
	fi
